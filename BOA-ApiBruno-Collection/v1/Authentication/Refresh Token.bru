meta {
  name: Refresh Token
  type: http
  seq: 4
}

post {
  url: {{domain}}/api/v1/token-refresh/
  body: json
  auth: inherit
}

body:json {
  {
    "refresh":"{{refresh_token}}"
  }
}

tests {
  const data = res.getBody();
  
  bru.setEnvVar("access_token", data.access);
  
  if (data.refresh) {
      bru.setEnvVar("refresh_token", data.refresh);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
